@model System.Data.DataRow
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card p-5 mt-4">
            <div class="mb-3 text-success">
                <i class="fa-solid fa-circle-check fa-4x"></i>
            </div>
            <h3 class="fw-bold mb-2">KẾT QUẢ BÀI THI</h3>
            <p class="text-muted">Đề thi: <strong>@Model["TenDeThi"]</strong></p>
            <hr />

            <div class="my-4">
                <h1 class="display-3 fw-bold text-primary">@Model["SoDiem"] <span class="fs-4 text-muted">/ 10</span></h1>
                <p class="text-secondary mt-2">
                    Số câu đúng: <strong class="text-success fs-5">@Model["SoCauDung"]</strong> / @Model["TongSoCau"] câu
                </p>
                <div class="badge bg-light text-dark p-2 border">
                    Thí sinh: @Model["HoTen"] | Hoàn thành lúc: @Convert.ToDateTime(Model["ThoiGianNopBai"]).ToString("HH:mm:ss dd/MM/yyyy")
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-3">
                <a href="/Exam/Index" class="btn btn-outline-primary"><i class="fa-solid fa-list me-1"></i>Về danh sách đề thi</a>
                <button onclick="window.print()" class="btn btn-secondary"><i class="fa-solid fa-print me-1"></i>In bảng điểm</button>
            </div>
        </div>
    </div>
</div>
