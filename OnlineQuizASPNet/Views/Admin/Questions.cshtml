@model System.Data.DataTable
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Ngân Hàng Câu Hỏi</h3>
    <a href="/Admin/CreateQuestion" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Thêm Câu Hỏi</a>
</div>

<div class="card p-0 overflow-hidden">
    <table class="table table-hover table-striped mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 70px;">Mã</th>
                <th style="width: 220px;">Môn học</th>
                <th>Nội dung câu hỏi</th>
                <th style="width: 140px;">Loại</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow r in Model.Rows)
            {
                <tr>
                    <td>@r["MaCauHoi"]</td>
                    <td><span class="badge badge-subject">@r["TenMon"]</span></td>
                    <td>@r["NoiDung"]</td>
                    <td><span class="badge bg-secondary">@r["LoaiCauHoi"]</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
