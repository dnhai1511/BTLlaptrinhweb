@model System.Data.DataTable
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Kết Quả Thi Của Thí Sinh</h3>
</div>

<div class="card p-0 overflow-hidden">
    <table class="table table-hover table-striped mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã KQ</th>
                <th>Thí sinh</th>
                <th>Tài khoản</th>
                <th>Đề thi</th>
                <th>Số câu đúng</th>
                <th>Điểm số</th>
                <th>Thời gian nộp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow r in Model.Rows)
            {
                <tr>
                    <td>@r["MaKetQua"]</td>
                    <td><strong>@r["HoTen"]</strong></td>
                    <td><code>@r["TaiKhoan"]</code></td>
                    <td>@r["TenDeThi"]</td>
                    <td>@r["SoCauDung"] / @r["TongSoCau"]</td>
                    <td><strong class="text-primary fs-6">@r["SoDiem"]</strong></td>
                    <td>@Convert.ToDateTime(r["ThoiGianNopBai"]).ToString("HH:mm:ss dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
